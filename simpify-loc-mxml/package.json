{
  "name": "nms-loc-converter",
  "version": "1.0.0",
  "description": "Convert No Man's Sky localization files between MXML and JSON",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "merge": "node merge.js",
    "translate": "npm start -- --mode translate-mxml"
  },
  "keywords": ["nms", "localization", "converter"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "xml2js": "^0.6.2",
    "@types/xml2js": "^0.4.14"
  }
}
