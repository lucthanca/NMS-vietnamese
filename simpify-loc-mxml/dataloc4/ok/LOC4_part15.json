{
  "PLANET_DIGGING_DESC": "Chúng luyên thuyên đầy phấn khích, nói về một tàn tích cổ xưa có triển vọng lớn. Chúng cho tôi xem dữ liệu của họ, manh mối đã đưa chúng đến gần cổ vật này.&#xA;&#xA;Chúng không thể tự mình đi tìm, vì vậy yêu cầu tôi làm việc này thay. Chúng nói rằng tôi có thể giữ cổ vật cho riêng mình, miễn là tôi ghi lại mọi khám phá lịch sử quan trọng dưới tên của họ.",
  "PLANET_COLLECT_DESC": "Chúng có vẻ bồn chồn, rất cần một loại vật chất cụ thể. Vì những lý do tôi không hiểu rõ, chúng không thể rời bỏ vị trí của mình để tự mình thu thập nó.&#xA;&#xA;Chúng đã đề nghị một phần thưởng hậu hĩnh nếu tôi thu thập giúp và mang nó trở lại tiền đồn của họ.",
  "PLANET_DELIVER_DESC": "Chúng có một vật phẩm mà chúng tuyên bố cần được vận chuyển, nhưng chúng không thể tự mình thực hiện hành trình. Chúng có vẻ sợ hãi điều gì đó, mặc dù tôi không thể xác định chính xác là gì.&#xA;&#xA;Chúng đã đề nghị một phần thưởng đáng kể nếu tôi thực hiện việc giao hàng thành công thay mặt chúng.",
  "PLANET_DEPOT_DESC": "Chúng luyên thuyên một loạt tọa độ, chỉ trỏ đầy phấn khích vào một bản đồ. Có vẻ chúng đã xác định được một kho tài nguyên. Vì những lý do tôi không hiểu rõ, chúng có vẻ phấn khích trước viễn cảnh kho này bị phá hủy.&#xA;&#xA;Chúng đề nghị tôi một khoản thanh toán hào phóng nếu tôi phá hủy kho này cho chúng.",
  "PLANET_RAID_DESC": "Chúng nói với tôi bằng giọng điệu nghiêm túc, chỉ ra một nhà máy gần đó. Có điều gì đó về cơ sở này đã khiến chúng lo lắng sâu sắc, vì có vẻ như chúng muốn nó bị đột kích.&#xA;&#xA;Sinh vật sống đã đề nghị một phần thưởng đáng kể nếu tôi thâm nhập vào cơ sở và truy cập ngân hàng dữ liệu của nó. Chúng cảnh báo tôi nên lường trước việc Sentinels sẽ phản ứng bằng vũ lực.",
  "PLANET_MISSING_DESC": "Thật khó để hiểu chính xác ý của chúng, nhưng có vẻ như một đồng nghiệp của chúng đã mất tích. Chúng đang rất đau khổ và tìm kiếm sự giúp đỡ trong việc truy tìm họ.&#xA;&#xA;Chúng đề nghị tôi một phần thưởng lớn nếu tôi giúp chúng tìm 'người bạn' mất tích của chúng.",
  "UI_RETURN_MPMISSION_OBJ": "Quay lại Dị Thường Không Gian",
  "UI_RETURN_MPMISSION_OBJ_TIP": "Quay lại Nexus để nhận phần thưởng của bạn.&#xA;Triệu hồi Dị Thường Không Gian từ Menu Nhanh (&lt;IMG&gt;QUICK_MENU&lt;&gt;) khi ở ngoài không gian.",
  "UI_RETURN_MPMISSION_OBJ1_MSG": "Quay lại Nexus để nhận phần thưởng của bạn.&#xA;Triệu hồi Dị Thường Không Gian từ Menu Nhanh (&lt;IMG&gt;QUICK_MENU&lt;&gt;) khi ở ngoài không gian.",
  "UI_RETURN_MPMISSION_OBJ1_OSD": "Quay lại Dị Thường Không Gian",
  "UI_RETURN_MPMISSION_OBJ1_MARKER": "Nexus",
  "UI_RETURN_PLANET_OBJ": "Quay lại sinh vật sống",
  "UI_RETURN_PLANET_OBJ_TIP": "Quay lại sinh vật sống để thông báo về thành công của bạn và nhận phần thưởng.",
  "UI_RETURN_PLANET_OBJ1_MSG": "Quay lại sinh vật sống&#xA;Tìm sinh vật sống tại tiền đồn của họ",
  "UI_RETURN_PLANET_OBJ1_OSD": "Quay lại sinh vật sống",
  "UI_RETURN_PLANET_OBJ1_MARKER": "Quay lại sinh vật sống",
  "UI_RETURN_GUILD_OBJ": "Quay lại Đặc Phái Viên Hiệp Hội",
  "UI_RETURN_GUILD_OBJ_TIP": "Quay lại Đặc Phái Viên Hiệp Hội trên trạm không gian để thông báo về thành công của bạn và nhận phần thưởng.",
  "UI_RETURN_GUILD_OBJ1_MSG": "Quay lại Đặc Phái Viên Hiệp Hội&#xA;Tìm Đặc Phái Viên Hiệp Hội trên một trạm không gian",
  "UI_RETURN_GUILD_OBJ1_OSD": "Quay lại Đặc Phái Viên Hiệp Hội",
  "UI_RETURN_GUILD_OBJ1_MARKER": "Quay lại Đặc Phái Viên Hiệp Hội",
  "EXP_PLANET_MISSION_DESC": "Mặt nạ của sinh vật sống nhấp nháy một mẫu lặp đi lặp lại. Chúng ra hiệu về bản kê khai của mình, như muốn tuyển dụng tôi cho một nhiệm vụ nào đó.",
  "TRA_PLANET_MISSION_DESC": "Pheromone của người ngoài hành tinh lấp đầy căn phòng với một mùi hương được thiết kế để làm tôi thấy thoải mái. Có vẻ như chúng cần giúp đỡ với một nhiệm vụ nào đó...",
  "WAR_PLANET_MISSION_DESC": "Mặc dù người ngoài hành tinh này ít nhiều gây sợ hãi, nhưng tư thế không phải là hung hăng. Quả thực, chúng có vẻ đang yêu cầu sự giúp đỡ của tôi...",
  "DNT_EXP_PLANET_MISSION_LANG1": "Thực thể lang thang, Sự Hội Tụ tìm kiếm sự hỗ trợ của bạn. Hãy đi đến nơi chúng tôi không thể.",
  "DNT_EXP_PLANET_MISSION_LANG2": "Lữ khách. Korvax thấy bạn là gì. Hãy giúp Korvax, và Korvax sẽ giúp bạn.",
  "DNT_EXP_PLANET_MISSION_LANG3": "Thông qua Sự Hội Tụ, Korvax đi đến mọi nơi. Nhưng thực thể vỏ bọc cần được hỗ trợ.",
  "DNT_TRA_PLANET_MISSION_LANG1": "Tất cả những ai đi qua cửa đều là bạn! Bạn sẽ giúp, phải không?",
  "DNT_TRA_PLANET_MISSION_LANG2": "Bạn trông dũng cảm và mạnh mẽ! Bạn sẽ giúp Gek, phải không? Tất cả đều là bạn ở đây?",
  "DNT_TRA_PLANET_MISSION_LANG3": "Bạn, tôi đề nghị một giao dịch. Phần thưởng thú vị cho công việc thú vị! Phải không?",
  "DNT_WAR_PLANET_MISSION_LANG1": "Grah! Kẻ xâm nhập! Ta sẽ tha thứ cho sự xâm phạm của ngươi nếu ngươi giúp ta.",
  "DNT_WAR_PLANET_MISSION_LANG2": "Nơi này chỉ dành cho Vy'keen! Hãy chứng minh giá trị của ngươi, kẻ xâm nhập!",
  "DNT_WAR_PLANET_MISSION_LANG3": "Grah! Multi-Tool của ngươi thật dễ coi, kẻ xâm nhập! Ngươi có muốn sử dụng nó không?",
  "NPC_PLANET_MISSION_ACCEPT_OPT": "Xem chi tiết yêu cầu",
  "EXP_PLANET_MISSION_RES": "Mặt nạ của sinh vật sống nhấp nháy thêm một lần nữa. Tôi không thể đọc được phản ứng của chúng. Tôi sẽ phải hoàn thành nhiệm vụ của chúng để tìm hiểu thêm.",
  "TRA_PLANET_MISSION_RES": "Sinh vật sống nhảy nhót, vui vẻ. Chúng vẫy tay, như thể chúc tôi may mắn.",
  "WAR_PLANET_MISSION_RES": "Người ngoài hành tinh lầm bầm với tôi, và làm một cử chỉ cảm ơn không mấy ấn tượng. Chúng quay đi, gần như không mong đợi gặp lại tôi.",
  "NPC_PLANET_MISSION_OPT": "Báo cáo thành công",
  "EXP_PLANET_MISSION_DONE_RES": "Korvax làm một cử chỉ cảm ơn. Chúng quét tôi một cách ngắn gọn, ghi chú vào hồ sơ của mình. Hoàn thành việc ghi sổ, chúng trao cho tôi phần thưởng.",
  "TRA_PLANET_MISSION_DONE_RES": "Gek kêu lên đầy phấn khích. Chúng đưa cho tôi phần thưởng, hoàn thành thỏa thuận của chúng tôi.",
  "WAR_PLANET_MISSION_DONE_RES": "Vy'keen chào khi tôi rời đi. Tôi đã giành được sự tôn trọng của chúng.",
  "DNT_EXP_PLANET_MISSION_COMP1": "Thực thể Lữ khách quay lại, với hào quang thành công. Báo cáo của bạn?",
  "DNT_TRA_PLANET_MISSION_COMP1": "Bạn! Bạn còn sống! Ngày vui vẻ! Bạn mang tin tốt sao?",
  "DNT_WAR_PLANET_MISSION_COMP1": "Grah! Ngươi đã trở lại trong vinh quang, kẻ xâm nhập?",
  "UI_MP_MISSION_TUT_TITLE": "Nhiệm Vụ Đa Phi Hành Đoàn",
  "UI_MP_MISSION_TUT_SUB": "Nhiệm Vụ Nguy Hiểm Thiên Hà",
  "UI_MP_MISSION_TUT_DESC": "&lt;STELLAR&gt;Nhiệm Vụ Thiên Hà&lt;&gt; mang lại phần thưởng lớn cho những nhà thám hiểm dũng cảm.&#xA;Ghé thăm Thiết Bị Nhiệm Vụ Thiên Hà trên tàu chở hàng của bạn.&#xA;&lt;FUEL&gt;CẢNH BÁO&lt;&gt;: Các nhà thám hiểm được khuyến nghị không nên thực hiện những nhiệm vụ này một mình.",
  "UI_MP_MISSION_TUT_OBJ": "Kiểm tra Thiết Bị Nhiệm Vụ Thiên Hà",
  "UI_MP_MISSION_TUT_OBJ_TIP": "Thiết Bị Nhiệm Vụ Thiên Hà trên tàu chở hàng của bạn cung cấp các nhiệm vụ đầy thử thách.&#xA;Các nhà thám hiểm được khuyến nghị không nên thực hiện các nhiệm vụ này một mình.",
  "UI_MP_MISSION_TUT_MSG1": "Nhiệm Vụ Chuyên Gia Có Sẵn&#xA;Ghé thăm Tàu Chở Hàng của bạn để tìm hiểu thêm",
  "UI_MP_MISSION_TUT_MSG2": "Nhiệm Vụ Chuyên Gia Có Sẵn&#xA;Xem xét các cơ hội tại Thiết Bị Nhiệm Vụ Thiên Hà",
  "UI_RECOVER_BASE_TITLE": "Khôi Phục Căn Cứ Chính",
  "UI_RECOVER_BASE_SUB": "Tìm địa điểm căn cứ mới",
  "UI_RECOVER_BASE_DESC": "&lt;FUEL&gt;CẢNH BÁO&lt;&gt;: Căn cứ đã được lưu trữ bởi các cơ quan bản đồ có liên quan.&#xA;Thực hiện khôi phục bằng cách tìm kiếm các địa điểm thích hợp và yêu cầu tái thiết sơ đồ.",
  "UI_RECOVER_BASE_OSD": "ĐÃ TÌM THẤY ĐỊA ĐIỂM CĂN CỨ PHÙ HỢP",
  "UI_RECOVER_BASE_MARKER": "Địa Điểm Căn Cứ Phù Hợp",
  "UI_RECOVER_BASE_OBJ": "Tìm một địa điểm mới cho căn cứ của bạn",
  "UI_RECOVER_BASE_OBJ_TIP": "Hạ cánh trên một hành tinh thích hợp và quét để tiết lộ các vị trí căn cứ tiềm năng",
  "UI_RECOVER_BASE_MSG1": "&lt;STELLAR&gt;Khôi Phục Căn Cứ&lt;&gt; đang tiến hành&#xA;Tìm và hạ cánh trên một hành tinh quê hương thích hợp",
  "UI_RECOVER_BASE_MSG2": "&lt;STELLAR&gt;Khôi Phục Căn Cứ&lt;&gt; đang tiến hành&#xA;Thực hiện Quét (&lt;IMG&gt;SCAN&lt;&gt;) để xác định một địa điểm phù hợp",
  "UI_RECOVER_BASE_MSG3": "&lt;STELLAR&gt;Khôi Phục Căn Cứ&lt;&gt; đang tiến hành&#xA;Đến địa điểm và yêu cầu khôi phục",
  "UI_HYP_RECOVER_MSG1": "Cài đặt hoặc Sửa chữa Hypedrive",
  "UI_SCAN_PORTAL_MSG": "Tìm một Cổng Dịch Chuyển&#xA;Sử dụng &lt;IMG&gt;SCAN&lt;&gt; để quét môi trường xung quanh bạn.",
  "UI_EXO_BP_TIP": "Bản Thiết Kế &lt;TECHNOLOGY&gt;Exocraft&lt;&gt; mới có sẵn&#xA;Tham khảo &lt;TECHNOLOGY&gt;Đơn Vị Nghiên Cứu Xây Dựng&lt;&gt;",
